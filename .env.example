# Copy to .env and adjust.

# ── Required ──────────────────────────────────────────────────────────────────

# Matches docker-compose.yml out of the box.
DATABASE_URL=postgres://schedra:schedra@localhost:5442/schedra

# Must be the URL people actually reach — booking, verification and reset links
# are built from it.
SCHEDRA_URL=http://localhost:3000

# Signs session cookies. At least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-character-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Google sign-in. Both values or neither.
# Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: ${SCHEDRA_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (verification, password resets) via Resend.
# Leave RESEND_API_KEY empty in development and links are printed to the
# terminal instead of being sent.
RESEND_API_KEY=
# Must be a domain verified in Resend. The default only works for test sends.
EMAIL_FROM="Schedra <onboarding@resend.dev>"
