# Required
DATABASE_URL=postgres://schedra:schedra@localhost:5442/schedra
# Required both while building and while running the app. This becomes the
# canonical origin in prerendered marketing pages.
SCHEDRA_URL=http://localhost:3002
AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional outside local development. Non-local staging hostnames are inferred;
# set explicitly when using a custom staging domain.
# Set this explicitly to development, staging, or production in each deployment.
# Leaving it blank uses SCHEDRA_URL to infer the environment.
SCHEDRA_ENVIRONMENT=

# Runtime
# all: web and background jobs; web: HTTP only; worker: background jobs only
SCHEDRA_PROCESS_ROLE=all
DIRECT_URL=
INTEGRATION_ENCRYPTION_KEY=

# Database safety budgets (defaults shown)
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Private operations access (comma-separated emails)
PLATFORM_ADMIN_EMAILS=
OPERATIONS_ALERT_EMAILS=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple Calendar uses each user's Apple Account email and app-specific password
# over CalDAV. It does not require a platform OAuth client ID or secret. User
# credentials are encrypted with INTEGRATION_ENCRYPTION_KEY above. Deployment
# also needs outbound HTTPS access to *.icloud.com; there is no Apple variable.

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Email (configure SMTP or Resend outside local development)
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=

# Billing
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# 500 = 5%. Must stay above zero because Bachs destination charges require a
# platform share to cover processing, refund and dispute exposure.
PAID_BOOKING_PLATFORM_FEE_BPS=500
