# Copy to .env and adjust.

# ── Required ──────────────────────────────────────────────────────────────────

# Matches docker-compose.yml out of the box.
# Managed hosts usually need ?sslmode=require on the end.
DATABASE_URL=postgres://schedra:schedra@localhost:5442/schedra

# The public origin. Booking links, verification and reset emails, OAuth
# callbacks, canonical tags and og:image URLs are all built from it, so it must
# match the domain people actually reach — including the port in development.
#   production  https://schedra.xyz
#   staging     https://staging.schedra.xyz
SCHEDRA_URL=http://localhost:3002

# Signs session cookies. At least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-character-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Encrypts third-party refresh tokens at rest. Keep this stable when rotating
# AUTH_SECRET. When omitted, AUTH_SECRET is used for backwards compatibility.
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Only needed when DATABASE_URL points at a connection pooler. Neon gives you
# both: the pooled host contains "-pooler", the direct one does not. Migrations
# use this because DDL through PgBouncer is unreliable; the app keeps using the
# pooled URL and disables prepared statements automatically.
DIRECT_URL=

# Google sign-in and Google Calendar. Both values or neither. Enable the Google
# Calendar API for the same Cloud project before connecting a calendar.
# Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URIs — add every environment you use:
#   https://schedra.xyz/api/auth/callback/google
#   https://schedra.xyz/api/integrations/google-calendar/callback
#   https://staging.schedra.xyz/api/auth/callback/google
#   https://staging.schedra.xyz/api/integrations/google-calendar/callback
#   http://localhost:3002/api/auth/callback/google
#   http://localhost:3002/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoom video conferencing. Create a user-managed OAuth app and add the callback
# for each environment in its matching Development/Production configuration:
#   https://schedra.xyz/api/integrations/zoom/callback
#   https://staging.schedra.xyz/api/integrations/zoom/callback
#   http://localhost:3002/api/integrations/zoom/callback
# Required granular scopes: meeting:write:meeting, meeting:update:meeting,
# meeting:delete:meeting, meeting:read:list_meetings and user:read:user.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Transactional email. SMTP_URL takes precedence when both transports are set.
# Examples: smtps://user:password@smtp.example.com:465
#           smtp://user:password@smtp.example.com:587
# Local development may leave both values empty; staging and production may not.
SMTP_URL=
RESEND_API_KEY=
# The sender must be authorized by your SMTP host or verified in Resend.
EMAIL_FROM="Schedra <onboarding@resend.dev>"

# Team billing through Bachs (bachs.io). The base URL is derived from the key
# prefix, so going live is a key swap: sk_sandbox_… → sk_live_…
# Before any checkout works, in the Bachs dashboard for EACH environment:
#   1. Organization settings → balance_currencies must include USD and NGN,
#      otherwise every checkout fails with BASE_CURRENCY_NOT_HELD_BY_ORG.
#   2. Checkout settings → fee_preference must be "org_pays", or customers are
#      charged the processing fee on top of the subscription price.
# The webhook secret comes from Developer Portal → Webhooks → endpoint detail,
# and is different per environment. Point the endpoint at /api/webhooks/bachs.
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
